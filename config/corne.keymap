#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>


/ {

        behaviors {
                hml: homerow_mods_left {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_LEFT";
                        #binding-cells = <2>;
                        bindings = <&kp>, <&kp>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
                };

                hmr: homerow_mods_right {
                        compatible = "zmk,behavior-hold-tap";
                        label = "HOMEROW_MODS_RIGHT";
                        #binding-cells = <2>;
                        bindings = <&kp>, <&kp>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
                };
        };

        combos {
                compatible = "zmk,combos";

                combo_caps_word {
                        timeout-ms = <50>;
                        key-positions = <16 19>;
                        bindings = <&caps_word>;
                        layers = <0>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";

                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB/SHFT |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | ESC/SHFT | A/GUI | S/ALT | D/CTRL | F/SHFT |  G  |   |  H  | J/SHFT | K/CTRL | L/ALT | ;/GUI |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | DEL  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
// Combo: F + J (home indices) => Caps Word (default layer only)
// Hold LWR + RSE together => ADJUST layer (bootloader/reset/BT clear, WASD, media, see below)
                        bindings = <
   &mt LSHFT TAB &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &mt LSHFT ESC &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G   &kp H &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
   &mt LCTRL ESC &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp DEL
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |   TAB    |  1  |  2  |  3  |  4  |  5  |   |  6   |  7  |  8    |  9    |  0  | DEL |
// | ESC/SHFT |     | LFT | DWN |  UP | RGT |   | LFT  | DWN |  UP   | RGT   |     |     |
// |   CTRL   | BT0 | BT1 | BT2 | BT3 | BT4 |   | HOME | END | PG_UP | PG_DN |     |     |
//                        | GUI |     | SPC |   | ENT  |     |  ALT  |
// NOTE: thumb-row &trans at LWR/RSE positions must stay transparent — they're what let
// holding LWR+RSE together fall through to ADJUST layer (see conditional_layers above).
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp DEL
   &mt LSHFT ESC &trans    &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT      &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LCTRL  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp HOME &kp END  &kp PG_UP &kp PG_DN &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |    `     |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | ESC/SHFT |  ;  |  :  |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// |   CTRL   |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                        | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  GRAVE  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &mt LSHFT ESC &kp SEMI &kp COLON &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                adjust_layer {
// -----------------------------------------------------------------------------------------
// | BOOT|     |  W  |     |     |     |   | PLAY| VOL-| VOL+| PREV| NEXT| BOOT |
// |     |  A  |  S  |  D  |     |     |   |     |     |     |     |     |      |
// |RESET|     |     |     |     |     |   |     |     |     |     |     |BTCLR |
//                    |     |     |     |   |     |     |     |
// Active only while LWR (mo 1) + RSE (mo 2) are both held.
                        bindings = <
   &bootloader &trans &kp W &trans &trans &trans   &kp C_PP &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT &bootloader
   &trans      &kp A &kp S &kp D &trans &trans   &trans &trans &trans &trans &trans &trans
   &sys_reset  &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &bt BT_CLR
                             &trans &trans &trans   &trans &trans &trans
                        >;
                };
        };
};
